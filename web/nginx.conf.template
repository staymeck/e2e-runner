# Rendered from this .template by the official nginx image's own entrypoint (envsubst), using
# API_UPSTREAM from the container's environment (see Dockerfile). The entrypoint only substitutes
# names that are actual environment variables, so nginx's own $uri/$http_upgrade/etc. below are left
# untouched — only ${API_UPSTREAM} gets replaced.
server {
    listen 80;

    # The React app does its own client-side routing (react-router); a reload on a deep link like
    # /mobile/escenarios/login must still serve index.html, not a 404 from nginx looking for that path
    # as a real file.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # The built JS calls /v1/... as same-origin relative paths (see web/src/api/client.ts) — this
    # container is not a full API gateway, just what a browser needs to reach the real e2e-runner
    # service, wherever it actually runs.
    location /v1/ {
        proxy_pass http://${API_UPSTREAM}/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Required for the job log WebSocket (GET /v1/jobs/:id/stream) — a plain HTTP proxy_pass
        # would otherwise answer the upgrade handshake itself instead of forwarding it.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}

# e2e-runner no carga este archivo solo: lee `process.env` directo, sin dotenv.
# Cargalo a mano antes de arrancar, por ejemplo:
#   set -a; source .env; set +a; npm run dev
#
# Ver src/config/load-config.ts y src/adapters/detox/detox-config.ts para la validación exacta.

# ============ Obligatorias (el servicio no arranca sin ellas) ============

# Clave de la API: mínimo 16 caracteres imprimibles, sin espacios. La usa cualquier
# llamada HTTP (Authorization: Bearer ...) y también el login de la web.
E2E_SERVICE_API_KEY=

# Carpeta absoluta donde el servicio guarda su base SQLite y los logs de cada corrida.
E2E_SERVICE_DATA_DIR=

# Ruta absoluta a un archivo JSON con los proyectos configurados (ejemplo en README.md).
E2E_SERVICE_CONFIG=

# Las dos carpetas del catálogo Detox: worktrees DISTINTOS del mismo repo. Obligatorias
# solo si projects.json tiene un proyecto con "adapter": "detox" (hoy, el único caso).
# E2E_DETOX_RUNNER_DIR: donde corren los jobs; el servicio la mueve entre job y job.
E2E_DETOX_RUNNER_DIR=
# E2E_DETOX_INFO_DIR: para listar ramas/escenarios sin tocar un job en ejecución.
E2E_DETOX_INFO_DIR=

# ============ Opcionales ============

# Host/puerto HTTP del servicio. Default: 127.0.0.1 / 8090.
# E2E_SERVICE_HOST=127.0.0.1
# E2E_SERVICE_PORT=8090

# Usuarios fijos para loguearse en la web: "usuario:password:rol,usuario2:password2:rol2".
# Roles válidos: e2e-mobile, e2e-cypress, admin. Password mínimo 8 caracteres.
# Vacío (default) = nadie puede loguearse en la web; la API con la key sigue funcionando igual.
# E2E_WEB_USERS=

# Segunda API key válida en paralelo a E2E_SERVICE_API_KEY, para rotarla sin cortar servicio.
# E2E_SERVICE_API_KEY_NEXT=

# Nivel de log de pino. Default: info.
# E2E_SERVICE_LOG_LEVEL=info

# Suscriptores de webhooks firmados (HMAC): "host:secret[:secretAnterior],otroHost:secret".
# El host no puede contener ":"; el secreto no puede contener "," ni ":". Vacío (default) =
# los webhooks quedan deshabilitados por completo.
# E2E_WEBHOOK_SUBSCRIBERS=

# ============ No la lee e2e-runner, pero tiene que estar en el entorno ============

# Ruta al Android SDK. load-config.ts no la valida, pero se reenvía sin filtrar al proceso
# hijo (perfect-qa) que la necesita para encontrar adb.
# ANDROID_HOME=
